{
    "name": "crustum/blazecast",
    "description": "Self-hosted WebSocket server for CakePHP applications",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "cakephp/cakephp": "6.x-dev",
        "crustum/plugin-manifest": "2.x-dev",
        "crustum/rhythm": "2.x-dev",
        "clue/redis-react": "^2.6",
        "firebase/php-jwt": "^6.11 || ^7.0",
        "guzzlehttp/psr7": "^2.6|^3.0",
        "pusher/pusher-php-server": "^7.2",
        "ratchet/rfc6455": "^0.4",
        "react/async": "^4.3",
        "react/promise": "^3.2",
        "react/promise-timer": "^1.10",
        "react/socket": "^1.14",
        "skie/signal_handler": "2.x-dev",
        "symfony/routing": "^7.3",
        "symfony/http-foundation": "^6.0 | ^7.0",
        "symfony/config": "^7.0"
    },
    "require-dev": {
        "cakedc/cakephp-phpstan": "5.next-cake6-dev",
        "cakephp/bake": "4.x-dev",
        "cakephp/cakephp-codesniffer": "6.x-dev",
        "jasonmccreary/double": "^1.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5",
        "ratchet/pawl": "^0.4",
        "react/http": "^1.7",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\BlazeCast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestApp\\": "tests/TestApp/",
            "Crustum\\BlazeCast\\Test\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "phpunit --coverage-html coverage",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/ tests/",
        "stan-test": "phpstan analyse  tests/",
        "stan-baseline": "phpstan analyse src/ tests/ --generate-baseline"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": false
    },
    "repositories": []
}
